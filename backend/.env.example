ENVIRONMENT=development

# Leave unset for local SQLite at backend/campusloop.db.
# Production example (placeholder only):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/campusloop

# Generate a private value locally with: openssl rand -hex 32
JWT_SECRET=replace-with-a-private-random-value
JWT_EXPIRY_MINUTES=60
# Comma-separated exact origins. Wildcards are intentionally rejected.
ALLOWED_FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cloudinary (required in production). Local development falls back to local /uploads/ storage.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
