# Leave DATABASE_URL unset to use backend/campusloop.db regardless of where
# Uvicorn is started. To override it, provide a valid SQLAlchemy URL.
# DATABASE_URL=sqlite:////absolute/path/to/backend/campusloop.db

# Generate a private value locally with: openssl rand -hex 32
JWT_SECRET=replace-with-a-private-random-value
JWT_EXPIRY_MINUTES=60
ALLOWED_FRONTEND_ORIGIN=http://localhost:5173
